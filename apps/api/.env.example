NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tecnoria
JWT_SECRET=change-me-to-a-very-long-secret
CORS_ORIGIN=http://localhost:4000
COOKIE_NAME=tecnoria_session
UPLOADS_DIR=./uploads
CUTOVER_AUTH=true
CUTOVER_BLOG=true
CUTOVER_CONTACT=true
CUTOVER_SCRAPER=true
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Optional alternative to FIREBASE_SERVICE_ACCOUNT_PATH
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
ADMIN_EMAIL=admin@tecnoria.com
ADMIN_PASSWORD=change-me-please
