{
  "name": "tecnoria-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Tecnoria monorepo: Angular SSR web + custom API + shared types",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:deps:up": "docker compose --project-name tecnoria-dev -f infra/docker-compose.dev.yml up -d",
    "dev:deps:down": "docker compose --project-name tecnoria-dev -f infra/docker-compose.dev.yml down",
    "dev:web": "npm run -w apps/web start",
    "dev:ssr": "npm run -w apps/web dev:ssr",
    "build:types": "npm run -w packages/shared-types build",
    "build:web": "npm run -w apps/web build",
    "build:ssr:web": "npm run -w apps/web build:ssr",
    "serve:ssr:web": "npm run -w apps/web serve:ssr",
    "dev:api": "npm run -w apps/api dev",
    "build:api": "npm run -w apps/api build",
    "start:api": "npm run -w apps/api start",
    "migrate:api": "npm run -w apps/api migrate",
    "seed:admin": "npm run -w apps/api seed:admin",
    "test:seo": "tsx scripts/seo-check.ts",
    "test:consent": "node --test scripts/tests/consent.test.mjs",
    "test:analytics": "node --test scripts/tests/analytics-dispatch.test.mjs",
    "test:browser": "node --test scripts/browser-consent.mjs",
    "test:api": "node --import tsx --test \"scripts/api-tests/*.test.mjs\"",
    "test:links": "node --test scripts/tests/internal-links.test.mjs",
    "test:perf": "node --test scripts/tests/perf-baseline.test.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs --samples 5",
    "test:monitor": "node scripts/growth-monitor.mjs",
    "test:all": "npm run test:seo && npm run test:links && npm run test:perf && npm run test:consent && npm run test:analytics && npm run test:api",
    "verify:web": "npm run build:web && npm run test:seo",
    "build": "npm run build:types && npm run build:web && npm run build:api"
  }
}
